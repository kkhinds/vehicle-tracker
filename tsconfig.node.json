{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@main/*": ["electron/main/*"]
    }
  },
  // The main process shares the renderer's domain types, so they have to be
  // part of this project too or tsc refuses to follow the import.
  "include": ["electron/**/*", "electron.vite.config.ts", "src/types/**/*"]
}
